# Copy to .env.local for a laptop, or add each one in Vercel > raw-red > Settings > Environment Variables.
# Never commit real values. Full setup steps: work/09-payments-delivery.md

# Pretend payments and delivery prices, to click through the checkout (never works in production).
# Vercel previews without a PAYSTACK_SECRET_KEY use it automatically; set 0 to force it off.
# CHECKOUT_DEMO=1

# The site's own address, used for Paystack's return link. Leave unset on Vercel previews.
SITE_URL=https://rawrooibos.com

# Any long random string. Signs delivery quotes so prices can't be edited in the browser.
ORDER_SIGNING_SECRET=

# Paystack > Settings > API Keys & Webhooks. Use sk_test_... until you're ready to take real money.
PAYSTACK_SECRET_KEY=sk_test_
# Optional: the whsec_... webhook signing secret, if your dashboard shows one.
PAYSTACK_WEBHOOK_SECRET=

# Bob Go > Settings > API keys. Sandbox account and URL first; live: https://api.bobgo.co.za/v2
BOBGO_API_KEY=
BOBGO_API_URL=https://api.sandbox.bobgo.co.za/v2
# Where the courier collects from (one line of JSON). zone = province code, code = postal code.
BOBGO_COLLECTION_ADDRESS={"company":"Raw Rooibos","street_address":"","local_area":"","city":"","zone":"WC","code":"","contact_name":"","contact_phone":"","contact_email":"hello@rawrooibos.com"}

# Resend (resend.com) for order emails to the shop and the customer. Optional: without it, emails go to the log.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Raw Rooibos <orders@rawrooibos.com>
SHOP_EMAIL=hello@rawrooibos.com
