{
  "$description": "Raw Rooibos design tokens, redesign 2026-10-24 (D08 evolve Fynbos Fresh, D10 12px controls). W3C design tokens format. Tiers: global (raw values), semantic (purpose; components use these), component (only where a part diverges). Light theme only (D04). Skill: 05-ai-design-systems/design-tokens.",
  "global": {
    "color": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "sage-100": { "$type": "color", "$value": "#EEEFE5", "$description": "Page canvas, sampled from Erick's reference (D07)" },
      "sage-300": { "$type": "color", "$value": "#D9E1D3" },
      "sage-600": { "$type": "color", "$value": "#73836D" },
      "fynbos-800": { "$type": "color", "$value": "#2F4B3A" },
      "ember-600": { "$type": "color", "$value": "#B03F1C" },
      "ember-700": { "$type": "color", "$value": "#8F3217" },
      "clay-100": { "$type": "color", "$value": "#F3E6D6" },
      "ink-900": { "$type": "color", "$value": "#1E2420" },
      "ink-600": { "$type": "color", "$value": "#566057" }
    },
    "font": {
      "family": { "$type": "fontFamily", "$value": ["Albert Sans", "system-ui", "sans-serif"] },
      "weight-regular": { "$type": "fontWeight", "$value": 400 },
      "weight-medium": { "$type": "fontWeight", "$value": 500 },
      "weight-semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "24": { "$type": "dimension", "$value": "96px" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "20px" },
      "lg": { "$type": "dimension", "$value": "28px" },
      "round": { "$type": "dimension", "$value": "999px" }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "exit": { "$type": "duration", "$value": "160ms" },
      "enter": { "$type": "duration", "$value": "200ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.25, 1, 0.5, 1] },
      "in": { "$type": "cubicBezier", "$value": [0.5, 0, 0.75, 0] }
    }
  },
  "semantic": {
    "color": {
      "surface-canvas": { "$type": "color", "$value": "{global.color.sage-100}", "$description": "Page background" },
      "surface-container": { "$type": "color", "$value": "{global.color.white}", "$description": "White containers on the canvas" },
      "surface-inverse": { "$type": "color", "$value": "{global.color.fynbos-800}", "$description": "Delivery strip, closing block, footer, buy bar. Never put ember on it (1.63:1)" },
      "surface-note": { "$type": "color", "$value": "{global.color.clay-100}" },
      "text-primary": { "$type": "color", "$value": "{global.color.ink-900}" },
      "text-secondary": { "$type": "color", "$value": "{global.color.ink-600}", "$description": "Not on surface-inverse" },
      "text-accent": { "$type": "color", "$value": "{global.color.ember-600}", "$description": "Emphasis only: the hero word, tagline, cart count. Light surfaces only" },
      "text-on-inverse": { "$type": "color", "$value": "{global.color.white}" },
      "text-on-inverse-secondary": { "$type": "color", "$value": "{global.color.sage-100}" },
      "action-primary": { "$type": "color", "$value": "{global.color.fynbos-800}" },
      "action-primary-hover": { "$type": "color", "$value": "{global.color.ember-600}" },
      "action-primary-pressed": { "$type": "color", "$value": "{global.color.ember-700}" },
      "action-primary-text": { "$type": "color", "$value": "{global.color.white}" },
      "action-inverse": { "$type": "color", "$value": "{global.color.white}", "$description": "Primary button on surface-inverse" },
      "action-inverse-hover": { "$type": "color", "$value": "{global.color.sage-100}" },
      "action-inverse-pressed": { "$type": "color", "$value": "{global.color.sage-300}" },
      "action-inverse-text": { "$type": "color", "$value": "{global.color.ink-900}" },
      "border-control": { "$type": "color", "$value": "{global.color.sage-600}", "$description": "3:1 or better on white and sage. The only allowed control edge" },
      "border-divider": { "$type": "color", "$value": "{global.color.sage-300}", "$description": "Decorative only, never a control's only edge" },
      "selected": { "$type": "color", "$value": "{global.color.fynbos-800}" },
      "focus": { "$type": "color", "$value": "{global.color.ink-900}" },
      "focus-on-inverse": { "$type": "color", "$value": "{global.color.white}" },
      "error": { "$type": "color", "$value": "{global.color.ember-700}", "$description": "Error text 7.96:1 on white; always paired with an icon and words" },
      "backdrop": { "$type": "color", "$value": "rgba(30, 36, 32, 0.5)" }
    },
    "font-size": {
      "display": { "$type": "dimension", "$value": "clamp(2.75rem, 6.4vw, 5.25rem)" },
      "headline": { "$type": "dimension", "$value": "clamp(2rem, 4vw, 3.25rem)" },
      "title": { "$type": "dimension", "$value": "1.5rem" },
      "price": { "$type": "dimension", "$value": "2.5rem" },
      "lead": { "$type": "dimension", "$value": "1.1875rem" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "small": { "$type": "dimension", "$value": "0.875rem", "$description": "Floor for all readable text" },
      "badge": { "$type": "dimension", "$value": "0.75rem", "$description": "Cart count numerals only; the count is also in the button's accessible name" }
    },
    "line-height": {
      "display": { "$type": "number", "$value": 1 },
      "headline": { "$type": "number", "$value": 1.05 },
      "title": { "$type": "number", "$value": 1.15 },
      "snug": { "$type": "number", "$value": 1.2, "$description": "Buttons, pack sizes, step titles" },
      "lead": { "$type": "number", "$value": 1.55 },
      "body": { "$type": "number", "$value": 1.6 }
    },
    "border-width": {
      "control": { "$type": "dimension", "$value": "1.5px" },
      "focus": { "$type": "dimension", "$value": "2px" },
      "focus-offset": { "$type": "dimension", "$value": "2px" }
    },
    "motion": {
      "nudge": { "$type": "dimension", "$value": "3px", "$description": "Secondary CTA arrow shift on hover" }
    },
    "letter-spacing": {
      "display": { "$type": "dimension", "$value": "-0.035em" },
      "headline": { "$type": "dimension", "$value": "-0.03em" },
      "title": { "$type": "dimension", "$value": "-0.02em" }
    },
    "space": {
      "inline-sm": { "$type": "dimension", "$value": "{global.space.2}" },
      "inline-md": { "$type": "dimension", "$value": "{global.space.4}" },
      "stack-sm": { "$type": "dimension", "$value": "{global.space.3}" },
      "stack-md": { "$type": "dimension", "$value": "{global.space.6}" },
      "stack-lg": { "$type": "dimension", "$value": "{global.space.8}" },
      "container-padding": { "$type": "dimension", "$value": "{global.space.6}" },
      "section-gap-phone": { "$type": "dimension", "$value": "{global.space.16}" },
      "section-gap-desktop": { "$type": "dimension", "$value": "{global.space.24}" },
      "gutter-phone": { "$type": "dimension", "$value": "{global.space.4}" },
      "gutter-tablet": { "$type": "dimension", "$value": "{global.space.6}" },
      "gutter-desktop": { "$type": "dimension", "$value": "{global.space.12}" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "{global.radius.sm}", "$description": "Buttons, inputs, pack sizes, stepper (D10)" },
      "card": { "$type": "dimension", "$value": "{global.radius.md}", "$description": "FAQ rows, craft step photos, small containers" },
      "panel": { "$type": "dimension", "$value": "{global.radius.lg}", "$description": "Buy box, bulk card, closing block, dialogs" },
      "badge": { "$type": "dimension", "$value": "{global.radius.round}" }
    },
    "size": {
      "target-min": { "$type": "dimension", "$value": "44px" },
      "control-height": { "$type": "dimension", "$value": "48px" },
      "control-height-lg": { "$type": "dimension", "$value": "56px", "$description": "Add to cart, pack sizes, stepper" },
      "content-max": { "$type": "dimension", "$value": "1200px" },
      "measure": { "$type": "dimension", "$value": "60ch" },
      "buy-bar-height": { "$type": "dimension", "$value": "72px" }
    },
    "breakpoint": {
      "phone-max": { "$type": "dimension", "$value": "520px", "$description": "Stepper on its own row; CTAs stack full width; buttons may wrap" },
      "buy-bar-max": { "$type": "dimension", "$value": "767px", "$description": "Buy bar and Menu button below this; header CTA and inline nav from 768px" },
      "wide": { "$type": "dimension", "$value": "1024px" }
    }
  },
  "component": {
    "button": {
      "font-size": { "$type": "dimension", "$value": "{semantic.font-size.body}" },
      "font-weight": { "$type": "fontWeight", "$value": "{global.font.weight-semibold}" },
      "padding-inline": { "$type": "dimension", "$value": "24px 20px", "$description": "Start 24, end 20 to balance the trailing arrow (pepperplane: 24 / 16)" },
      "icon-size": { "$type": "dimension", "$value": "16px" },
      "icon-gap": { "$type": "dimension", "$value": "{global.space.3}" },
      "press-scale": { "$type": "number", "$value": 0.97 }
    }
  }
}
